{
  "name": "devin-devkit",
  "version": "0.1.0",
  "description": "Install public Devin CLI profiles through uv",
  "author": { "name": "Icaro0310" },
  "repository": "https://github.com/Icaro0310/devin-devkit",
  "license": "MIT",
  "keywords": ["devin", "devkit", "installer", "profiles", "uv"],
  "mcpServers": {
    "devin-devkit": {
      "command": "uvx",
      "args": ["--from", "devin-devkit[mcp]", "devin-devkit-mcp"]
    }
  }
}
