{
  "name": "devin-devkit",
  "displayName": "devin-devkit",
  "description": "Install-plan previews and update checks from devin-devkit, inside the editor. Read-only thin adapter: the extension shells out to the devin-devkit CLI and renders plans — it never passes the apply/force flags, so previews stay dry-runs.",
  "version": "0.1.1",
  "publisher": "icaro0310",
  "license": "MIT",
  "devin-devkit-cli": ">=0.1.0,<0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Icaro0310/devin-devkit.git",
    "directory": "packages/devkit/adapters/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "devin",
    "installer",
    "profiles",
    "tooling"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "devinDevkit.executable",
        "devinDevkit.checkOnStartup"
      ],
      "description": "Runs the user-installed devkit CLI on demand. In Restricted Mode the workspace-configured executable is ignored and the CLI never runs automatically (the startup compat check and checkOnStartup are skipped)."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "devin-devkit.status",
        "title": "devin-devkit: Check for tool updates"
      },
      {
        "command": "devin-devkit.profiles",
        "title": "devin-devkit: List install profiles"
      },
      {
        "command": "devin-devkit.list",
        "title": "devin-devkit: List manifest tools"
      },
      {
        "command": "devin-devkit.previewInstall",
        "title": "devin-devkit: Preview install plan (dry run)"
      },
      {
        "command": "devin-devkit.previewUpdate",
        "title": "devin-devkit: Preview update plan (dry run)"
      }
    ],
    "configuration": {
      "title": "devin-devkit",
      "properties": {
        "devinDevkit.executable": {
          "type": "string",
          "default": "devin-devkit",
          "description": "devin-devkit executable (name or absolute path)"
        },
        "devinDevkit.checkOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Check for outdated tools when VS Code starts"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {}
}
